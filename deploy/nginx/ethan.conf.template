# Ethan — Nginx reverse proxy (plantilla)
# deploy.sh sustituye __DOMAIN__ y __APP_PORT__ y luego Certbot añade el bloque 443 + redirección HTTP→HTTPS.
# Instalación manual:
#   sed -e 's/__DOMAIN__/tu-dominio.com/g' -e 's/__APP_PORT__/3000/g' ethan.conf.template > /etc/nginx/sites-available/ethan.conf
#   ln -s /etc/nginx/sites-available/ethan.conf /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
#   certbot --nginx -d tu-dominio.com --redirect
#
# IMPORTANTE: el micrófono (Web Speech API) solo funciona en HTTPS. Sin SSL, Ethan no puede escucharte.

# Soporte WebSocket: Connection "upgrade" solo si el cliente lo pide (nombre único para no chocar con otros sitios)
# '' → "" (y no "close") para reutilizar conexiones keepalive con el upstream
map $http_upgrade $ethan_connection_upgrade {
    default upgrade;
    ''      "";
}

upstream ethan_app {
    server 127.0.0.1:__APP_PORT__;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Mensajes de chat + historial; el backend limita a 256 KB
    client_max_body_size 1m;

    # Cabeceras de seguridad (microphone=(self) es necesario para hablar con Ethan)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;

    # --- Protección opcional con usuario/contraseña (complementa la allowlist de IPs) ---
    # sudo apt install apache2-utils && sudo htpasswd -c /etc/nginx/.ethan_htpasswd tu_usuario
    # auth_basic "Ethan - Private";
    # auth_basic_user_file /etc/nginx/.ethan_htpasswd;

    location / {
        # Allowlist de IPs (deploy.sh --allow-ip). Va aquí y no en el server para que el reto HTTP-01
        # que Certbot inyecta (/.well-known/acme-challenge/…) siga accesible y el SSL se renueve solo
        include /etc/nginx/ethan-allowlist.conf;

        proxy_pass http://ethan_app;
        proxy_http_version 1.1;

        # WebSocket / SSE
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ethan_connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming: el audio TTS y SSE se entregan en cuanto llegan, sin acumular en buffer
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        # Los modelos locales (Ollama) pueden tardar; Gemini responde en segundos
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    # Los assets con hash de Vite ya salen del backend con Cache-Control immutable: no hace falta una
    # location aparte (y un add_header ahí anularía las cabeceras de seguridad de este bloque)
}
