PORT=4000
# Motor por defecto: claude | gemini | ollama | mock (se cambia en caliente desde la UI; la elección se guarda)
# Si el motor elegido no está configurado, el servidor arranca en modo demo (mock) y lo avisa en la UI
AI_PROVIDER=mock

# Claude vía Claude Code CLI en modo desatendido (usa tu suscripción Pro/Max, sin API key)
# Servidor: genera el token con `claude setup-token` y pégalo aquí. En tu PC basta con tener sesión iniciada en `claude`
CLAUDE_CODE_OAUTH_TOKEN=
# claude-sonnet-5 (recomendado) | claude-haiku-4-5-20251001 (más barato)
CLAUDE_MODEL=claude-sonnet-5
# Razonamiento extendido: 0 = desactivado (más rápido y barato para conversación de voz)
CLAUDE_MAX_THINKING_TOKENS=0
# Ruta del binario si no está en el PATH
CLAUDE_BIN=

# Configuración Google Gemini (Recomendado para producción/VPS) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Si Google retiró el modelo (error "model not available"), prueba gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash
# Tarifa para estimar el coste de modelos sin precio conocido (USD por millón de tokens)
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=

# Configuración Ollama Local (opcional). En Docker usa http://host.docker.internal:11434
# OLLAMA_ENABLED=true lo muestra en el selector de motores de la UI
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Tolerancia a fallos de red del motor IA (opcionales)
# Timeout por intento en ms (default: 30000 gemini / 120000 ollama) y reintentos en errores transitorios (default 2)
AI_TIMEOUT_MS=
AI_MAX_RETRIES=

# Voz Edge-TTS (en-US-ChristopherNeural, en-US-GuyNeural, en-US-JennyNeural, en-GB-RyanNeural)
TTS_VOICE=en-US-ChristopherNeural

# Carpeta del progreso del usuario (default: packages/backend/data). En Docker: /app/packages/backend/data
DATA_DIR=
